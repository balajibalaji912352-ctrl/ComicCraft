# ComicCraft settings
DEBUG=true
DEMO_MODE=false

# Required for real Gemini generation.
GEMINI_API_KEY=your_gemini_api_key_here

# The PDF used Gemini 1.5 Flash/Pro. These defaults use newer supported model IDs.
# If your account does not have access, replace these with models available in your Google AI Studio account.
GEMINI_OUTLINE_MODEL=gemini-2.5-flash
GEMINI_STORY_MODEL=gemini-2.5-pro

# Image generation: diffusers = real Stable Diffusion; demo = lightweight placeholder images.
IMAGE_BACKEND=diffusers
STABLE_DIFFUSION_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
HF_API_KEY=
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=25
IMAGE_GUIDANCE_SCALE=7.5
